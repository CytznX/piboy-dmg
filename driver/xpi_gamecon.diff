+
+static ssize_t pwm1_enable_store(struct device *dev, struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	unsigned long v;
+
+	if (kstrtoul(buf, 10, &v) || v > 1)
+		return -EINVAL;
+	xpi_fan_enable = v;
+	xpi_fan_last_set = jiffies;
