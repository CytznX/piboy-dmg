#!/usr/bin/env python3
"""piboy-escaped - owns the PiBoy's input devices, and the two things that fall out.

Job one is the Start+Select escape hatch for console emulators. Job two is
idle blanking of the LCD, which lives here because "when did input last
arrive" is the signal it needs and this process already has it: it enumerates
/dev/input, masks events in-kernel, follows hotplug via inotify, and blocks
with zero wakeups while idle. A separate daemon would duplicate all of that,
and a polling timer would give back the very property this one is built on.

RetroArch already exits on Start+Select, but emulators launched with the CON:
prefix (frotz, and anything else console-based) never see a RetroArch hotkey -
there is no way out of them with a gamepad, and the only remaining option is a
power cycle. On a device where every unclean shutdown risks the filesystem, that
is the one exit path worth removing.

Deliberately narrow, so it can never interfere with normal play:
  * fires ONLY while runcommand.sh is running - never on the EmulationStation
    menu, where Start and Select are ordinary buttons
  * a 2s hold fires ONLY when RetroArch is absent - RetroArch keeps handling
    its own hotkey (Select+Start is literally its exit combo on this pad), and a
    second killer racing it would be worse than useless
  * a 5s hold fires REGARDLESS. A RetroArch stuck in uninterruptible I/O - which
    happens when something else saturates the card - processes no input at all,
    so deferring to its hotkey means deferring to nothing and the only way out
    is cutting power. That is the exact failure this daemon exists to remove.
  * requires the combo to be HELD. Most ports run standalone, not under
    RetroArch, so this daemon is what catches them - and in those games Start is
    an ordinary menu button. An instant trigger would kill Duke Nukem or Quake 3
    the moment someone pressed both. A deliberate hold cannot collide with play.
  * SIGTERM, then SIGKILL after a grace period, so the emulator gets its chance
    to save and restore the terminal

Watches evdev codes rather than joystick button indices, so it works for the
PiBoy pad and a plugged-in USB pad without per-device configuration, and picks
up hotplugged pads (notably Bluetooth, which reconnects long after boot) via
inotify rather than a rescan timer.
"""
import collections, ctypes, fcntl, os, glob, select, signal, struct, sys, time

EV_SYN      = 0x00
EV_KEY      = 0x01
BTN_SELECT  = 0x13a
BTN_START   = 0x13b
EV_SIZE     = struct.calcsize('llHHi')      # 24 bytes on 64-bit
GRACE       = 3.0                           # seconds between SIGTERM and SIGKILL
HOLD        = 2.0                           # console emulators: RetroArch absent
HOLD_FORCE  = 5.0                           # anything, including a wedged RetroArch
SHELLS      = {'bash', 'sh', 'dash', 'runcommand.sh'}

# Idle blanking. The XPi owns LCD power through bit 0 of this register - it is
# not DRM/DPMS, and it is the only software path to the backlight, which is the
# largest single draw on a battery handheld.
FLAGS_NODE  = '/sys/kernel/xpi_gamecon/flags'
BL_POWER    = '/sys/class/backlight/piboy/bl_power'   # preferred: bit-safe
# Overridable so the behaviour can be exercised without waiting five minutes,
# and tuned without editing this file. 0 disables blanking entirely.
IDLE_BLANK  = float(os.environ.get('PIBOY_IDLE_BLANK', 300))
DRM_GLOB    = '/sys/class/drm/card*-HDMI-A-*'

def log(msg):
    print(f"piboy-escaped: {msg}", flush=True)

def snapshot():
    """One pass over /proc -> {pid: (ppid, comm, cmdline)}.

    Everything escape() needs - runcommand detection, RetroArch detection, the
    descendant walk and the log names - comes out of this single sweep. The
    previous shape re-listed /proc once per frontier node and walked cmdlines
    twice more, which is thousands of file opens at exactly the moment the card
    is already saturated enough that RetroArch has wedged.
    """
    procs = {}
    for entry in os.listdir('/proc'):
        if not entry.isdigit():
            continue
        pid = int(entry)
        try:
            with open(f'/proc/{pid}/stat') as f:
                # comm can contain spaces and ')'; fields after the final ')'
                # are fixed-width, so split there rather than on whitespace.
                ppid = int(f.read().rsplit(')', 1)[1].split()[1])
            with open(f'/proc/{pid}/comm') as f:
                comm = f.read().strip()
            with open(f'/proc/{pid}/cmdline', 'rb') as f:
                cmdline = f.read()
        except (OSError, ValueError, IndexError):
            continue
        procs[pid] = (ppid, comm, cmdline)
    return procs


def descendants(procs, root):
    """Every pid below root, from an already-taken snapshot."""
    children = {}
    for pid, (ppid, _, _) in procs.items():
        children.setdefault(ppid, []).append(pid)
    out, frontier = [], [root]
    while frontier:
        for pid in children.get(frontier.pop(), ()):
            out.append(pid)
            frontier.append(pid)
    return out


def escape(force=False):
    """Returns True if it acted, False if it deliberately declined."""
    procs = snapshot()
    # Match only a shell actually executing runcommand.sh, not anything whose
    # cmdline merely mentions it (an editor, a grep, this daemon's own args), and
    # take the newest so a nested invocation from a +Start launcher wins over its
    # parent. dict order is not launch order, so rc[0] was arbitrary.
    rc = sorted(p for p, (_, comm, cmd) in procs.items()
                if b'runcommand.sh' in cmd and comm in SHELLS)
    if not rc:
        return False                            # nothing launched; ES is in charge
    if not force and any(b'retroarch' in cmd for _, _, cmd in procs.values()):
        return False                            # RetroArch handles its own hotkey

    targets = [p for p in descendants(procs, rc[-1]) if procs[p][1] not in SHELLS]
    if not targets:
        return False
    log(f"Start+Select: terminating {[(p, procs[p][1]) for p in targets]}")
    for p in targets:
        try: os.kill(p, signal.SIGTERM)
        except OSError: pass
    deadline = time.time() + GRACE
    while time.time() < deadline:
        if not any(os.path.exists(f'/proc/{p}') for p in targets):
            log("exited cleanly")
            return True
        time.sleep(0.2)
    # A process wedged in uninterruptible I/O ignores SIGTERM entirely.
    for p in targets:
        try:
            os.kill(p, signal.SIGKILL)
            log(f"pid {p} ignored SIGTERM - killed")
        except OSError:
            pass
    return True


def hdmi_active():
    """True when an external display is lit and carrying the picture.

    `enabled`, not `status`: a cable plugged in after boot leaves the connector
    connected but disabled, because SDL's KMSDRM backend picks a connector once
    at startup and never migrates - EmulationStation is still on the panel and
    blanking it would leave no visible display at all. Only when the connector
    is enabled is the panel genuinely redundant, and then piboy-display owns it;
    this daemon must keep its hands off either way.
    """
    for d in glob.glob(DRM_GLOB):
        try:
            with open(os.path.join(d, 'enabled')) as f:
                if f.read().strip() != 'enabled':
                    continue
            with open(os.path.join(d, 'status')) as f:
                if f.read().strip() == 'connected':
                    return True
        except OSError:
            continue
    return False


def panel_off():
    """Is the panel currently dark, according to the register itself?

    Deliberately a read rather than a remembered flag. piboy-display writes this
    same register on hotplug, so a cached bool goes stale in both directions: it
    would relight the panel on the next keypress after an HDMI swap deliberately
    blanked it, and it would never re-blank a panel that piboy-display switched
    back on. Bit 0 is the panel; the rest of the byte belongs to other things
    (bit 7 = reboot pending), so test the bit, never the whole value.
    """
    try:
        with open(BL_POWER) as f:
            return f.read().strip() != '0'
    except OSError:
        pass
    try:
        with open(FLAGS_NODE) as f:
            return not (int(f.read().strip() or 1) & 1)
    except (OSError, ValueError):
        return False


def lcd(on):
    """Switch the panel. Returns False if the node cannot be written, so the
    caller can stop trying rather than log once per idle period forever."""
    # bl_power first: it touches the panel bit alone. Writing FLAGS_NODE sets
    # the whole byte and would clear bit 7, the reboot flag, which is how soft
    # reboot silently stopped resuming.
    try:
        with open(BL_POWER, 'w') as f:
            f.write('0\n' if on else '4\n')     # 0 = ON, 4 = POWERDOWN
        return True
    except OSError:
        pass
    # Fallback for a driver without the backlight class. Read-modify-write on
    # bit 0 only - a bare write clears bit 7, the reboot flag.
    try:
        with open(FLAGS_NODE) as f:
            cur = int(f.read().strip() or 1)
        with open(FLAGS_NODE, 'w') as f:
            f.write('%d\n' % ((cur | 1) if on else (cur & ~1)))
        return True
    except (OSError, ValueError):
        return False


# EVIOCSMASK = _IOW('E', 0x93, struct input_mask{u32 type; u32 size; u64 ptr})
EVIOCSMASK = 0x40104593


def _set_mask(fd, ev_type, mask):
    """Ask the kernel to deliver only the bits set in mask for ev_type."""
    buf = ctypes.create_string_buffer(bytes(mask), len(mask))
    req = struct.pack('IIQ', ev_type, len(mask), ctypes.addressof(buf))
    fcntl.ioctl(fd, EVIOCSMASK, req)      # buf stays referenced until this returns


def filter_to_buttons(fd):
    """Deliver button presses on this fd, dropping the pad's idle chatter.

    The PiBoy pad syncs on a 125Hz timer, so an unfiltered fd wakes this daemon
    ~20 times a second forever on EV_ABS/EV_SYN traffic it does not care about.
    The TYPE mask is what stops that, and it is the part that matters.

    The CODE mask stays wide. The kernel drops masked-out codes before
    userspace sees them, so narrowing it to the two combo buttons would mean
    the panel could only be woken with Start or Select - which is not
    discoverable, and reads as a screen that will not come back. Being wide
    costs one wakeup per button press, which by definition only happens when
    someone is already there; the idle case that matters is still zero.

    KNOWN LIMIT: the TYPE mask admits EV_KEY only, so axis traffic neither
    defers nor cancels a blank. On the built-in pad that costs nothing - its
    d-pad and every button are EV_KEY (only the thumbstick is ABS) - but a pad
    whose d-pad is ABS_HAT, such as an Xbox controller, cannot wake the panel
    with the d-pad alone; any face button does. Admitting EV_ABS is not an
    option: measured on this hardware, an idle pad emits 0 events/sec with
    EV_KEY alone and 50/sec once EV_ABS is allowed, because the driver syncs
    on a 125Hz timer. That would cost more battery every second than blanking
    saves.

    Best-effort: older kernels and some drivers reject EVIOCSMASK, and an
    unfiltered fd still works correctly.
    """
    try:
        type_mask = bytearray(8)                       # which EV_* types at all
        type_mask[EV_KEY // 8] |= 1 << (EV_KEY % 8)
        _set_mask(fd, EV_SYN, type_mask)

        _set_mask(fd, EV_KEY, b'\xff' * 96)            # every key: any button wakes the panel
        return True
    except OSError:
        return False


# A pad that appears after startup has to be picked up, and Bluetooth is the
# case that forces the issue: it reconnects asynchronously and slowly, so on
# most boots a paired controller lands well after this daemon has already
# scanned /dev/input. inotify rather than a rescan timer, because the whole
# point of the EVIOCSMASK filtering above is that an idle daemon costs zero
# wakeups, and a polling rescan would hand that straight back.
IN_ATTRIB = 0x00000004      # udev chowns the node to root:input AFTER creating
IN_CREATE = 0x00000100      # it, and IN_ATTRIB on a directory watch reports that
IN_DELETE = 0x00000200      # chown - so the wakeup that makes the node openable
                            # arrives on its own. No retry timer is needed.
DEBOUNCE  = 0.3             # udev emits CREATE then several ATTRIB per node;
                            # settle before reconciling, so one hotplug costs one
                            # pass instead of four to six.
POLL      = 2.0             # only when inotify is unavailable: then a slow scan
                            # is the sole way a device is ever noticed.
RETRY     = 1.0             # re-open window after an open() failed
RETRY_MAX = 5               # ...bounded, so a node that can never be opened
                            # cannot become a permanent 1Hz wakeup.

# Named rather than positional: a previous edit changed this function's arity
# and left one of three call sites unpacking the old count, which is a runtime
# error, so it passed every syntax check and crashlooped the service instead.
Sync = collections.namedtuple('Sync', 'added removed masked failed')


def inotify_watch(path='/dev/input'):
    """Non-blocking inotify fd watching `path`, or None if unavailable."""
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        libc.inotify_init1.argtypes = [ctypes.c_int]
        libc.inotify_init1.restype = ctypes.c_int
        libc.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
        libc.inotify_add_watch.restype = ctypes.c_int
        fd = libc.inotify_init1(os.O_NONBLOCK)
        if fd < 0:
            return None
        if libc.inotify_add_watch(fd, path.encode(), IN_CREATE | IN_DELETE | IN_ATTRIB) < 0:
            os.close(fd)
            return None
        return fd
    except (OSError, AttributeError):
        return None


def drop_fd(fd, fds, held):
    """Close `fd` and forget everything keyed on it.

    `held` must go with the fd. A stale entry that still had both buttons down
    latches `complete` True for good: `since` never resets, `armed` never
    returns, and the escape hatch is dead for the rest of the process lifetime.
    """
    try: os.close(fd)
    except OSError: pass
    fds.pop(fd, None)
    held.pop(fd, None)


def sync_pads(fds, held):
    """Reconcile `fds` with /dev/input as it is now -> Sync(added, removed, masked, failed).

    Incremental on purpose. Closing and reopening everything would discard
    `held`, and any device whose buttons happened to be down at that moment
    would latch its state: `since` never resets, `armed` never returns, and the
    hatch is dead for the process lifetime.
    """
    current = set(glob.glob('/dev/input/event*'))
    added = masked = removed = failed = 0

    for path in sorted(current - set(fds.values())):
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            failed += 1                    # often just "udev has not chowned it yet"
            continue
        if filter_to_buttons(fd):
            masked += 1
        fds[fd] = path
        added += 1

    for fd, path in list(fds.items()):
        if path not in current:
            drop_fd(fd, fds, held)
            removed += 1

    return Sync(added, removed, masked, failed)

def main():
    running = True

    # A self-pipe registered with set_wakeup_fd. Without it, blocking in
    # select() with timeout=None is uninterruptible in practice: PEP 475 runs the
    # handler and then RESTARTS the syscall with the same (None) timeout, so
    # `running = False` is never observed and systemd waits out TimeoutStopSec
    # before SIGKILL. On this hardware that matters - the XPi cuts the rail about
    # 31s after a shutdown request, so a daemon that stalls shutdown risks being
    # killed mid-unmount.
    wake_r, wake_w = os.pipe()
    os.set_blocking(wake_r, False)
    os.set_blocking(wake_w, False)
    signal.set_wakeup_fd(wake_w)

    def stop(*_):
        nonlocal running
        running = False
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    held = {}                                   # fd -> set of codes currently down
    fds = {}

    # Unblank on startup, so a restart always recovers a panel that a previous
    # instance switched off and never switched back on - but NOT while an
    # external display is lit, where piboy-display has blanked it deliberately
    # and this would fight it on every restart.
    can_blank = False
    if IDLE_BLANK > 0:
        can_blank = os.access(BL_POWER, os.W_OK) or os.access(FLAGS_NODE, os.W_OK)
        if not can_blank:
            log(f"{FLAGS_NODE} not writable - idle blanking disabled")
        elif not hdmi_active():
            lcd(True)      # recover a panel a previous instance left dark
    last_input = time.time()

    # Install the watch BEFORE the first scan. The other order silently drops
    # every event in the gap, and with inotify up nothing else ever re-scans.
    # This unit is only After=multi-user.target, so it can start while udev is
    # still settling: a node not yet chowned to root:input fails to open, its
    # chown fires IN_ATTRIB before the watch exists, and that pad is missed for
    # the entire session with nothing logged.
    ino = inotify_watch()
    if ino is None:
        log("inotify unavailable - falling back to a slow /dev/input poll")

    first = sync_pads(fds, held)
    log(f"watching {len(fds)} input devices ({first.masked} kernel-filtered to buttons); "
        f"{HOLD:.0f}s to escape, {HOLD_FORCE:.0f}s to force")

    armed = True                                # require release before re-firing
    since = None                                # when the combo became complete
    next_try = 0.0                              # backoff for declined soft escapes
    # One deadline governs every re-scan of /dev/input: it absorbs the burst of
    # CREATE/ATTRIB events udev fires per node, retries an open that failed, and
    # degrades to a slow poll when inotify is unavailable. Zero means nothing is
    # pending - the idle case, and the one that must never cost a wakeup.
    retries = RETRY_MAX
    rescan_at = (time.time() + RETRY if first.failed
                 else 0.0 if ino is not None
                 else time.time() + POLL)

    while running:
        # Block indefinitely when no combo is in progress: the 0.25s poll only
        # exists to time a hold, and there is nothing to time until both buttons
        # are down. Idle cost drops to zero wakeups - the daemon sleeps until an
        # actual input event arrives - without giving up always-being-there,
        # which an on-demand daemon started from runcommand hooks cannot promise.
        # Never block indefinitely with no devices open - that would be a
        # permanently dead daemon with no path to recovery.
        if since is not None:
            timeout = 0.25                 # timing a hold
        elif rescan_at:
            timeout = max(0.0, rescan_at - time.time())
        elif can_blank:
            # A deadline, not a poll: sleep until the exact moment the
            # panel must blank, so idling still costs zero wakeups.
            timeout = max(0.0, (last_input + IDLE_BLANK) - time.time())
        elif fds:
            timeout = None                 # an input event or inotify will wake us
        else:
            timeout = POLL                 # nothing open: never block forever, or
                                           # a daemon that lost every device has no
                                           # way back even with inotify healthy

        watch = list(fds) + [wake_r] + ([ino] if ino is not None else [])
        try:
            ready, _, _ = select.select(watch, [], [], timeout)
        except (select.error, OSError):
            # The offending fd may be a device OR the inotify fd, and select does
            # not say which. Rebuild both: leaving a broken inotify fd in `watch`
            # makes every subsequent select raise, which spins a core until the
            # unit is stopped.
            for fd in list(fds):
                drop_fd(fd, fds, held)
            if ino is not None:
                try: os.close(ino)
                except OSError: pass
                ino = inotify_watch()
            sync_pads(fds, held)
            retries = RETRY_MAX
            # Schedule a reconcile rather than deciding retry policy here.
            # This used to discard the Sync result and then zero rescan_at,
            # so a re-open that failed (ENODEV during a Bluetooth flap, or a
            # node never chowned into `input`) was never retried and the
            # device stayed unwatched for the process lifetime. The block
            # below owns that policy; duplicating it is how the two drift.
            rescan_at = time.time() + (DEBOUNCE if ino is not None else POLL)
            continue

        if ino is not None and ino in ready:
            try:
                data = os.read(ino, 4096)  # drain; which entry changed is irrelevant
            except OSError:
                # A readable fd that will not read spins select at 100% forever,
                # so never just swallow this - replace the watch.
                data = b''
                try: os.close(ino)
                except OSError: pass
                ino = inotify_watch()
            if data:
                retries = RETRY_MAX
            rescan_at = time.time() + (DEBOUNCE if ino is not None else POLL)

        if rescan_at and time.time() >= rescan_at:
            r = sync_pads(fds, held)
            if r.added or r.removed:
                log(f"input devices changed (+{r.added} -{r.removed}); "
                    f"watching {len(fds)} ({r.masked} newly filtered)")
            # A failed open is not always the udev chown that IN_ATTRIB reports
            # on its own. ENODEV while a Bluetooth pad flaps, EMFILE, or a node
            # never chowned into `input` produce no further event at all - so
            # without this retry that device stays unwatched, and silently.
            if r.failed and retries > 0:
                retries -= 1
                rescan_at = time.time() + RETRY
                if retries == 0:
                    log(f"{r.failed} device(s) could not be opened; not retrying")
            elif ino is None or not fds:
                # Keep a slow reconcile armed when nothing is open, even with
                # inotify healthy. The POLL timeout below is useless on its
                # own: the rescan is gated on rescan_at, so leaving it 0.0 here
                # means the daemon wakes every POLL seconds and does nothing,
                # forever, with no path back to watching a device.
                rescan_at = time.time() + POLL
            else:
                rescan_at = 0.0

        if wake_r in ready:
            try: os.read(wake_r, 64)       # drain; the flag is already set
            except OSError: pass
            if not running:
                break

        for fd in ready:
            if fd not in fds:              # wake_r and ino are handled above
                continue
            try:
                data = os.read(fd, EV_SIZE * 64)
            except BlockingIOError:
                # Not device death. sync_pads may have closed and reopened
                # descriptors earlier in this same pass, so a number still in
                # `ready` can now name a different, freshly opened device with
                # nothing to read yet. Dropping it here would discard a device
                # that is perfectly healthy.
                continue
            except OSError:
                # Drop the recorded button state with the fd. A stale entry that
                # still had both buttons down would latch `complete` True for the
                # process lifetime: `since` never resets, `armed` never returns,
                # and the escape hatch can never fire again.
                drop_fd(fd, fds, held)
                # The node may still exist - a transient EIO on a marginal link,
                # not a removal - in which case no IN_DELETE is coming and nothing
                # would ever look at it again. Schedule a reconcile so it can be
                # re-opened rather than lost until the process restarts.
                soon = time.time() + DEBOUNCE
                rescan_at = soon if not rescan_at else min(rescan_at, soon)
                continue
            for off in range(0, len(data) - EV_SIZE + 1, EV_SIZE):
                _, _, etype, code, value = struct.unpack('llHHi', data[off:off + EV_SIZE])
                if etype != EV_KEY:
                    continue
                # Any button counts as interaction, not just the combo.
                last_input = time.time()
                # Ask the register, and leave it alone when an external display
                # is lit - there piboy-display blanked the panel on purpose.
                if can_blank and panel_off() and not hdmi_active():
                    lcd(True)
                    log("input - panel back on")
                if code not in (BTN_SELECT, BTN_START):
                    continue
                s = held.setdefault(fd, set())
                if value:                        # press or autorepeat
                    s.add(code)
                else:
                    s.discard(code)

        # Blank once the deadline passes. Deferred while an external display
        # is lit: there the panel is already off by piboy-display's doing,
        # and switching it back on when input arrives would undo that.
        if can_blank and time.time() - last_input >= IDLE_BLANK:
            if hdmi_active() or panel_off():
                last_input = time.time()   # nothing to do; re-arm rather than spin
            elif lcd(False):
                log(f"idle {IDLE_BLANK:.0f}s - panel off")
            else:
                can_blank = False
                log(f"could not write {FLAGS_NODE} - idle blanking disabled")

        # Evaluate the hold on every pass, not only on an event: autorepeat is
        # not guaranteed, so a held combo may produce no further events at all.
        complete = any(BTN_SELECT in v and BTN_START in v for v in held.values())
        if not complete:
            since, armed, next_try = None, True, 0.0
        elif since is None:
            since, next_try = time.time(), 0.0
        elif armed:
            now = time.time()
            elapsed = now - since
            if elapsed >= HOLD_FORCE:
                log("held %.0fs - forcing, even past RetroArch" % HOLD_FORCE)
                escape(force=True)
                armed = False
            elif elapsed >= HOLD and now >= next_try:
                # A decline means RetroArch is up and owns the short hold. Back
                # off rather than re-walking /proc four times a second while the
                # card is already struggling - the force tier still lands on time.
                if escape(force=False):
                    armed = False
                else:
                    next_try = now + 1.0

    # Never leave the panel dark for the next process to puzzle over. The unit's
    # ExecStopPost repeats this as root, which covers a crash or SIGKILL.
    if can_blank and panel_off() and not hdmi_active():
        lcd(True)

    for fd in fds:
        os.close(fd)
    if ino is not None:
        os.close(ino)
    log("stopped")

if __name__ == '__main__':
    sys.exit(main())
