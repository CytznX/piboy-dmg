[Unit]
Description=PiBoy DMG volume wheel -> ALSA mixer
# sound.target alone is not enough: open_wheel() needs the ABS_VOLUME input
# device that xpi_gamecon creates, and exits 1 if it is absent. With
# Restart=always/RestartSec=5 under StartLimitBurst=10 in 120s, a boot where the
# module loads late burns all ten attempts in ~50s and the unit fails
# permanently - the volume wheel is then dead until someone intervenes.
# piboy-fand already orders itself this way; this unit did not.
After=sound.target systemd-modules-load.service
Wants=systemd-modules-load.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
# Coalesce the OSD publishes. osd_min_ms defaults to 0, which makes the
# "backstop" test `now - last_draw >= osd_min_ms` always true, so the file is
# rewritten on EVERY wheel event - ~25 a second while turning. That was free
# when wob was the renderer and the reader was a shell builtin, but the OSD now
# forks notify-send per publish, and 25 forks a second mid-game is exactly the
# cost this project removed once already. 120ms caps it at ~8, and the 50ms
# quiet timer still delivers the value the wheel came to rest on.
Environment=PIBOY_OSD_MS=120
ExecStart=/usr/local/sbin/piboy-vold
Restart=always
RestartSec=5
# Bound the stop: a blocked read() can otherwise hold shutdown past the ~31s
# point where the XPi cuts the rail, i.e. mid-unmount.
TimeoutStopSec=5
SyslogIdentifier=piboy-vold

[Install]
WantedBy=multi-user.target
