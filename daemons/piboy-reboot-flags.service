[Unit]
# Without this the XPi cuts the rail on halt and never re-asserts it, so
# `systemctl reboot` takes the unit down and it stays down until the physical
# switch is flipped. Writing 129 (0x81) tells the board a reboot is coming.
# WantedBy=reboot.target, so it fires ONLY on reboot - on poweroff the rail
# should genuinely drop.
Description=Tell the XPi that a reboot, not a shutdown, is coming
DefaultDependencies=no
Before=reboot.target
After=final.target

[Service]
Type=oneshot
# The sleep is the point, not padding. Writing the value only sets a variable;
# the driver clocks the flags byte out when its turn comes round in a 4-way
# round-robin, ~33ms at 120Hz. Returning immediately races the rail dropping,
# and loses intermittently - observed: this unit logged that it ran and the
# unit still did not resume. Superseded by the driver's reboot notifier, which
# waits for proof of transmission instead of guessing.
ExecStart=/bin/sh -c 'echo 129 > /sys/kernel/xpi_gamecon/flags; sleep 0.3'
RemainAfterExit=no

[Install]
WantedBy=reboot.target
