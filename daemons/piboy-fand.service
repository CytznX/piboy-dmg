[Unit]
Description=PiBoy DMG fan curve and status policy
After=systemd-modules-load.service
# StartLimit* must live in [Unit]. systemd silently ignores them in [Service],
# which leaves Restart=always respawning forever if the module never loads.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/sbin/piboy-fand
# The script exits 1 if the xpi_gamecon sysfs tree is absent; Restart retries
# until the module is loaded. A ConditionPathExists would instead make systemd
# *skip* the unit on a boot race, and Restart never applies to a unit that was
# never started.
Restart=always
RestartSec=5
SyslogIdentifier=piboy-fand

[Install]
WantedBy=multi-user.target
