 }
 
+static std::string readSysfsLine(const std::string& path)
+{
+	std::ifstream f(path);
+	std::string line;
+	if(f && std::getline(f, line))
+		return line;
+	return "";
+}
+
+// Rebuilt on the same 500ms tick as the framerate counter, never per frame:
+// buildTextCache lays out glyphs, and Font.h is explicit that re-rendering a
+// cache is much cheaper than rebuilding one.
+void Window::updateStatusBar()
+{
+	std::stringstream ss;
+	
+	const time_t now = time(nullptr);
+	struct tm lt;
+	char clock[6] = { 0 };
+	if(localtime_r(&now, &lt))
+		strftime(clock, sizeof(clock), "%H:%M", &lt);
+	ss << clock;
+	
+	const std::string cap = readSysfsLine(STATUS_BAR_BATTERY "/capacity");
+	if(!cap.empty())
+	{
+		const std::string st = readSysfsLine(STATUS_BAR_BATTERY "/status");
+		ss << ((st == "Charging" || st == "Full") ? "  chg " : "  bat ") << cap << "%";
+	}
+	
+	const std::string text = ss.str();
+	// The clock only changes once a minute and capacity every few minutes, so
+	// ~119 of every 120 ticks would otherwise re-lay-out an identical string -
+	// sizeText and buildTextCache each walk it, and the cache is reallocated.
+	if(text == mStatusStr)
+		return;
+	mStatusStr = text;
+
+	auto& font = mDefaultFonts.at(0);
+	const float pad = 8.f;
+	const float w = font->sizeText(text).x();
+	mStatusText = std::unique_ptr<TextCache>(font->buildTextCache(
+		text, (float)Renderer::getScreenWidth() - w - pad, pad, 0xFFFFFFC8));
+}
