     if [[ -f "$script" ]]; then
-        bash "$script" "$SYSTEM" "$EMULATOR" "$ROM" "$COMMAND" </dev/tty 2>>"$LOG"
+        bash "$script" "$SYSTEM" "$EMULATOR" "$ROM" "$COMMAND" <"$TTY_IN" 2>>"$LOG"
     fi
 }
 
