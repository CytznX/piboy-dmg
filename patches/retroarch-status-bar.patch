diff -urN a/gfx/video_driver.c b/gfx/video_driver.c
--- a/gfx/video_driver.c	2026-09-13 23:13:30.688888267 -0400
+++ b/gfx/video_driver.c	2026-09-14 08:39:06.996594109 -0400
@@ -21,6 +21,22 @@
 #include <string/stdstring.h>
 #include <retro_math.h>
 #include <retro_timers.h>
+#include <time.h>
+#include <sys/stat.h>
+
+/* Status bar sources. Everything here is a small sysfs/procfs read; none of
+ * these values changes faster than once a minute, so they are refreshed on
+ * the FPS counter's cadence rather than at frame rate. Volume is the
+ * exception - it must feel live, so it is polled far more often, but only a
+ * stat() until the mtime actually moves. */
+#define STATUS_BAR_CAPACITY "/sys/class/power_supply/xpi-battery/capacity"
+#define STATUS_BAR_STATUS   "/sys/class/power_supply/xpi-battery/status"
+#define STATUS_BAR_THERMAL  "/sys/class/thermal/thermal_zone0/temp"
+#define STATUS_BAR_WIRELESS "/proc/net/wireless"
+#define STATUS_BAR_VOLUME   "/run/piboy-volume"
+#define STATUS_BAR_INTERVAL 600   /* frames between slow-field refreshes */
+#define STATUS_BAR_VOL_POLL   4   /* frames between volume stat() calls   */
+#define STATUS_BAR_VOL_MS  1800   /* how long a volume change stays shown */
 
 #ifdef HAVE_CONFIG_H
 #include "../config.h"
@@ -2576,6 +2592,7 @@
    video_info->memory_show                 = settings->bools.video_memory_show;
    video_info->statistics_show             = settings->bools.video_statistics_show;
    video_info->framecount_show             = settings->bools.video_framecount_show;
+   video_info->status_bar_show             = settings->bools.video_status_bar_show;
    video_info->core_status_msg_show        = runloop_st->core_status_msg.set;
    video_info->aspect_ratio_idx            = settings->uints.video_aspect_ratio_idx;
    video_info->post_filter_record          = settings->bools.video_post_filter_record;
@@ -3566,6 +3583,166 @@
          status_text[++buf_pos]   = '\0';
       }
 
+      /* Persistent status bar.
+       *
+       * Rides the same status_text that fps_show and memory_show build, because
+       * video_driver_frame() already pushes that every frame with duration 1 and
+       * flush=true - exactly what a permanent overlay needs, and the reason this
+       * needs no compositor. The clock travels separately in status_bar_clock
+       * because it is drawn at the opposite corner.
+       *
+       * Battery, temperature and signal come from sysfs/procfs: the frontend
+       * powerstate driver reports nothing on this board. Any field whose file is
+       * missing is simply omitted, so this degrades field by field rather than
+       * failing. */
+      if (video_info.status_bar_show)
+      {
+         static char     sb_fields[96];
+         static uint64_t sb_next;
+         static int      sb_vol      = -1;
+         static uint64_t sb_vol_next;
+         static int64_t  sb_vol_seen;
+         char            scratch[32];
+         FILE           *fp;
+
+         /* --- clock, drawn top-left --- */
+         if (video_st->frame_count >= sb_next || video_info.status_bar_clock[0] == '\0')
+         {
+            struct tm tm_now;
+            time_t    now = time(NULL);
+            size_t    n   = 0;
+
+            if (localtime_r(&now, &tm_now))
+               strftime(video_info.status_bar_clock,
+                     sizeof(video_info.status_bar_clock), "%H:%M", &tm_now);
+
+            /* --- battery, with charge state --- */
+            sb_fields[0] = '\0';
+            if ((fp = fopen(STATUS_BAR_CAPACITY, "r")))
+            {
+               int pct;
+               if (fscanf(fp, "%d", &pct) == 1 && pct >= 0 && pct <= 100)
+               {
+                  const char *tag = "bat";
+                  FILE *sf;
+                  if ((sf = fopen(STATUS_BAR_STATUS, "r")))
+                  {
+                     if (fgets(scratch, sizeof(scratch), sf))
+                        if (  !strncmp(scratch, "Charging", 8)
+                           || !strncmp(scratch, "Full", 4))
+                           tag = "chg";
+                     fclose(sf);
+                  }
+                  n += snprintf(sb_fields + n, sizeof(sb_fields) - n,
+                        "%s %d%%", tag, pct);
+               }
+               fclose(fp);
+            }
+
+            /* --- SoC temperature, millidegrees --- */
+            if ((fp = fopen(STATUS_BAR_THERMAL, "r")))
+            {
+               int milli;
+               if (fscanf(fp, "%d", &milli) == 1 && milli > 0 && milli < 200000)
+                  n += snprintf(sb_fields + n, sizeof(sb_fields) - n,
+                        "%s%dC", n ? "  " : "", (milli + 500) / 1000);
+               fclose(fp);
+            }
+
+            /* --- strongest wireless link.
+             * Picked by level rather than by interface name: a hotplug
+             * renumbers wlanN, and the good adapter is not reliably wlan0. */
+            if ((fp = fopen(STATUS_BAR_WIRELESS, "r")))
+            {
+               char line[160];
+               int  best = 1;   /* levels are negative dBm; 1 means none seen */
+               /* two header lines */
+               if (fgets(line, sizeof(line), fp) && fgets(line, sizeof(line), fp))
+               {
+                  while (fgets(line, sizeof(line), fp))
+                  {
+                     char *colon = strchr(line, ':');
+                     float link, level;
+                     if (!colon)
+                        continue;
+                     /* Fields after the colon are "status link level"; the
+                      * leading status word must be skipped or link picks up
+                      * 0000 and level picks up the link quality, which is
+                      * positive and fails the sanity check below - leaving the
+                      * field silently absent. */
+                     if (sscanf(colon + 1, "%*s %f %f", &link, &level) == 2)
+                     {
+                        int lv = (int)level;
+                        if (lv < 0 && (best > 0 || lv > best))
+                           best = lv;
+                     }
+                  }
+               }
+               if (best < 0)
+                  n += snprintf(sb_fields + n, sizeof(sb_fields) - n,
+                        "%s%ddBm", n ? "  " : "", best);
+               fclose(fp);
+            }
+
+            sb_next = video_st->frame_count + STATUS_BAR_INTERVAL;
+         }
+
+         /* --- volume, polled far more often but only stat() until it moves ---
+          * piboy-vold writes the wheel position here on every change. A recent
+          * mtime means the user is turning it now, so the bar shows volume
+          * instead of the static fields; otherwise the fields come back. */
+         if (video_st->frame_count >= sb_vol_next)
+         {
+            struct stat st;
+            sb_vol_next = video_st->frame_count + STATUS_BAR_VOL_POLL;
+            if (stat(STATUS_BAR_VOLUME, &st) == 0)
+            {
+               struct timespec ts;
+               int64_t age;
+               clock_gettime(CLOCK_REALTIME, &ts);
+               age = (int64_t)(ts.tv_sec - st.st_mtim.tv_sec) * 1000
+                   + (ts.tv_nsec - st.st_mtim.tv_nsec) / 1000000;
+               if (age >= 0 && age < STATUS_BAR_VOL_MS)
+               {
+                  if ((fp = fopen(STATUS_BAR_VOLUME, "r")))
+                  {
+                     int w;
+                     if (fscanf(fp, "%d", &w) == 1 && w >= 0 && w <= 100)
+                        sb_vol = w;
+                     fclose(fp);
+                  }
+                  sb_vol_seen = age;
+               }
+               else
+                  sb_vol = -1;
+            }
+            else
+               sb_vol = -1;
+         }
+         (void)sb_vol_seen;
+
+         if (buf_pos > 0)
+         {
+            status_text[  buf_pos] = ' ';
+            status_text[++buf_pos] = '|';
+            status_text[++buf_pos] = '|';
+            status_text[++buf_pos] = ' ';
+            status_text[++buf_pos] = '\0';
+         }
+         if (sb_vol >= 0)
+         {
+            /* A plain percentage, not a drawn bar: the widget renderer uses its
+             * own proportional font from the asset pack, so a bar of '=' and '-'
+             * would change width as it filled. */
+            snprintf(scratch, sizeof(scratch), "VOL %d%%", sb_vol);
+            buf_pos += strlcpy(status_text + buf_pos, scratch,
+                  sizeof(status_text) - buf_pos);
+         }
+         else
+            buf_pos += strlcpy(status_text + buf_pos, sb_fields,
+                  sizeof(status_text) - buf_pos);
+      }
+
       if ((video_st->frame_count % fps_update_interval) == 0)
       {
          size_t new_len;
@@ -3942,6 +4119,7 @@
           || video_info.framecount_show
           || video_info.memory_show
           || video_info.core_status_msg_show
+          || video_info.status_bar_show
          )
        && !((video_info.menu_st_flags & MENU_ST_FLAG_SCREENSAVER_ACTIVE))
        && !video_info.notifications_hidden
