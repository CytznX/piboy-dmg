--- dxx-rebirth.sh.orig-backup	2026-08-23 02:07:30.079338102 +0100
+++ dxx-rebirth.sh	2026-08-23 20:06:37.984090798 +0100
@@ -72,10 +72,10 @@
 
 function install_dxx-rebirth() {
     # Rename generic files
-    mv -f "$md_build/d1x-rebirth/INSTALL.txt" "$md_build/d1x-rebirth/D1X-INSTALL.txt"
-    mv -f "$md_build/d1x-rebirth/RELEASE-NOTES.txt" "$md_build/d1x-rebirth/D1X-RELEASE-NOTES.txt"
-    mv -f "$md_build/d2x-rebirth/INSTALL.txt" "$md_build/d2x-rebirth/D2X-INSTALL.txt"
-    mv -f "$md_build/d2x-rebirth/RELEASE-NOTES.txt" "$md_build/d2x-rebirth/D2X-RELEASE-NOTES.txt"
+    mv -f "$md_build/d1x-rebirth/INSTALL.txt" "$md_build/d1x-rebirth/D1X-INSTALL.txt" 2>/dev/null || true
+    mv -f "$md_build/d1x-rebirth/RELEASE-NOTES.txt" "$md_build/d1x-rebirth/D1X-RELEASE-NOTES.txt" 2>/dev/null || true
+    mv -f "$md_build/d2x-rebirth/INSTALL.txt" "$md_build/d2x-rebirth/D2X-INSTALL.txt" 2>/dev/null || true
+    mv -f "$md_build/d2x-rebirth/RELEASE-NOTES.txt" "$md_build/d2x-rebirth/D2X-RELEASE-NOTES.txt" 2>/dev/null || true
 
     local build_path="$(_get_build_path_dxx-rebirth)"
 
@@ -85,11 +85,10 @@
         'd1x-rebirth/README.RPi'
         "$build_path/d1x-rebirth/d1x-rebirth"
         'd1x-rebirth/d1x.ini'
-        'd1x-rebirth/D1X-INSTALL.txt'
+        'INSTALL.markdown'
         'd1x-rebirth/D1X-RELEASE-NOTES.txt'
         "$build_path/d2x-rebirth/d2x-rebirth"
         'd2x-rebirth/d2x.ini'
-        'd2x-rebirth/D2X-INSTALL.txt'
         'd2x-rebirth/D2X-RELEASE-NOTES.txt'
     )
 }

# Why: upstream DXX-Rebirth dropped the per-game INSTALL.txt in favour of one
# top-level INSTALL.markdown, and now ships RELEASE-NOTES.txt already renamed.
# RetroPie's module still renames all four and lists the old names in
# md_ret_files, so the install fails AFTER a successful 30-minute compile,
# reporting 'Could not successfully install' over two documentation files.
#
# NOTE: this edits a git-managed file. A RetroPie-Setup update will revert it.
# Re-apply with:  patch -p0 < dxx-rebirth-trixie.patch
